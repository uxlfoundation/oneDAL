build -c opt

build --flag_alias=backend_config=@config//:backend_config
build --flag_alias=test_link_mode=@config//:test_link_mode
build --flag_alias=test_external_datasets=@config//:test_external_datasets
build --flag_alias=test_tier=@config//:test_tier
# Accepted and ignored; dal-infra still passes it. Remove with the infra update.
build --flag_alias=test_thread_mode=@config//:test_thread_mode
build --flag_alias=test_disable_fp64=@config//:test_disable_fp64
build --flag_alias=release_dpc=@config//:release_dpc
build --flag_alias=device=@config//:device
build --flag_alias=cpu=@config//:cpu
build --flag_alias=enable_assert=@config//:enable_assert
build --flag_alias=stdalloc=@config//:stdalloc
build --flag_alias=rng_backend=@config//:rng_backend
build --flag_alias=build_parameters_lib=@config//:build_parameters_lib
build --flag_alias=code_coverage=@config//:code_coverage
build --flag_alias=msvc_runtime=@config//:msvc_runtime
build --flag_alias=build_date=@config//:build_date

# The SYCL OpenCL backend reads these to find the available devices.
test --test_env=OCL_ICD_FILENAMES \
     --test_env=SYCL_DEVICE_FILTER

test --test_env=FI_PROVIDER_PATH

# Bazel 9 gives tests a strict environment by default.
test --test_env=LD_LIBRARY_PATH

# MSVC env for the Windows actions. Windows only, as every --action_env value is part of
# every action key and Linux keys would then depend on the shell's PATH.
common --enable_platform_specific_config
build:windows --action_env=INCLUDE
build:windows --action_env=LIB
build:windows --action_env=PATH

# Windows stores the variable as `Path` (cmd) or `PATH` (MSYS bash); forward both.
test --test_env=PATH
test --test_env=Path

# Tests find the staged release DLLs on Windows through DALROOT.
test --test_env=DALROOT

test --test_env=DAAL_DATASETS

test --test_timeout=900

# Test selection by tag: `host` or `dpc` targets; add `-private` or `-public` to the filter to
# narrow further, e.g. `bazel test --test_tag_filters=host,-private //cpp/oneapi/dal:tests`.
build:host \
    --build_tag_filters="host"

test:host \
    --test_tag_filters="host"

# --release_dpc=true makes a missing DPC++ compiler a build error instead of skipping every test.
build:dpc \
    --build_tag_filters="dpc" \
    --release_dpc=true

test:dpc \
    --test_tag_filters="dpc"

# Kept for dal-infra, which still selects tests with these; `--test_tag_filters` does the same.
build:host-public --build_tag_filters="host,-private"
test:host-public --test_tag_filters="host,-private"
build:host-private --build_tag_filters="host,-public"
test:host-private --test_tag_filters="host,-public"
build:dpc-public --build_tag_filters="dpc,-private" --release_dpc=true
test:dpc-public --test_tag_filters="dpc,-private"
build:dpc-private --build_tag_filters="dpc,-public" --release_dpc=true
test:dpc-private --test_tag_filters="dpc,-public"

# //:release builds every ISA unless --cpu is set and adds the DPC++ libraries when icpx is found.
build:release-dpc \
    --release_dpc=true

# For jobs that publish a package: the version must carry --build_date, not the placeholder date.
build:release \
    --@config//:require_build_date

# Host ISA only, for local iteration. The platform suffix gives it its own
# output tree, so switching to and from the default build rebuilds nothing.
build:dev \
    --cpu=auto \
    --platform_suffix=dev


# Debug CRT (-MDd, Make MSVC_RUNTIME_VERSION=debug), independent of --config=dbg. Libraries get
# a `d` suffix so both flavours share one release tree; //:release_all builds both.
build:mdd \
    --msvc_runtime=debug


# Make: REQDBG=yes.
build:dbg \
    --compilation_mode=dbg \
    --enable_assert=True

# Make: REQDBG=symbols. Keeps the opt build's optimization level.
build:dbg-symbols \
    --copt=-g


# Make: REQSAN=address. Combine with --config=dbg.
# Every sanitizer keeps frame pointers and debug symbols.
build:sanitize \
    --copt=-fno-omit-frame-pointer \
    --config=dbg-symbols
build:asan \
    --config=sanitize \
    --copt=-fsanitize=address \
    --linkopt=-fsanitize=address
build:asan-static \
    --config=asan \
    --linkopt=-static-libasan
build:lsan \
    --config=sanitize \
    --copt=-fsanitize=leak \
    --linkopt=-fsanitize=leak
build:tsan \
    --config=sanitize \
    --copt=-fsanitize=thread \
    --linkopt=-fsanitize=thread
build:ubsan \
    --config=sanitize \
    --copt=-fsanitize=undefined \
    --linkopt=-fsanitize=undefined
build:msan \
    --config=sanitize \
    --copt=-fsanitize=memory \
    --copt=-fsanitize-memory-track-origins \
    --linkopt=-fsanitize=memory \
    --linkopt=-fuse-ld=lld
build:type \
    --config=sanitize \
    --copt=-fsanitize=type \
    --copt=-fsanitize-recover=all \
    --linkopt=-fsanitize=type \
    --linkopt=-fuse-ld=lld

# CI pipelines add `--config=ci` with their own --disk_cache and
# --experimental_disk_cache_gc_max_size, as the cache path and size differ per runner.
common:ci --announce_rc
common:ci --experimental_disk_cache_gc_idle_delay=0s
common:ci --test_output=errors

try-import %workspace%/user.bazelrc
