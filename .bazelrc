build -c opt \
      --incompatible_enable_cc_toolchain_resolution \
      --incompatible_require_linker_input_cc_api

build --flag_alias=backend_config=@config//:backend_config
build --flag_alias=test_link_mode=@config//:test_link_mode
build --flag_alias=test_thread_mode=@config//:test_thread_mode
build --flag_alias=test_external_datasets=@config//:test_external_datasets
build --flag_alias=test_nightly=@config//:test_nightly
build --flag_alias=test_weekly=@config//:test_weekly
build --flag_alias=test_disable_fp64=@config//:test_disable_fp64
build --flag_alias=release_dpc=@config//:release_dpc
build --flag_alias=device=@config//:device
build --flag_alias=cpu=@config//:cpu
build --flag_alias=enable_assert=@config//:enable_assert
build --flag_alias=stdalloc=@config//:stdalloc
build --flag_alias=rng_backend=@config//:rng_backend
build --flag_alias=build_parameters_lib=@config//:build_parameters_lib
build --flag_alias=code_coverage=@config//:code_coverage
build --flag_alias=msvc_runtime=@config//:msvc_runtime

# The SYCL OpenCL backend reads these to find the available devices.
test --test_env=OCL_ICD_FILENAMES \
     --test_env=SYCL_DEVICE_FILTER

test --test_env=FI_PROVIDER_PATH

# This flag is added for migration to Bazel 9.0.0:
# In Bazel 9.0.0, the strict action environment for tests is enabled by default
# (see https://github.com/bazelbuild/bazel/releases/tag/9.0.0)
# Instead of using --incompatible_strict_action_env, we explicitly pass
# the required environment variable to tests for compatibility:
test --test_env=LD_LIBRARY_PATH

# Forward the MSVC tooling env into Bazel-spawned build actions on Windows:
# INCLUDE and LIB for the compile and link actions, PATH for the `cmd.exe`
# copies of the release rule and the DPC++ link launcher.
#
# Windows only: every `--action_env` value is part of every action key. Linux
# actions do not take PATH from the shell, so the action keys do not depend on
# the shell's PATH (a conda env, `setvars.sh`, another terminal, another CI
# image) and caches are shared between machines. `build:windows` is applied
# automatically through --enable_platform_specific_config.
common --enable_platform_specific_config
build:windows --action_env=INCLUDE
build:windows --action_env=LIB
build:windows --action_env=PATH

# Windows stores the variable as `Path` (cmd) or `PATH` (MSYS bash); forward both.
test --test_env=PATH
test --test_env=Path

# Tests find the staged release DLLs on Windows through DALROOT.
test --test_env=DALROOT

test --test_env=DAAL_DATASETS

test --test_timeout=900

build:public \
    --build_tag_filters="-private"

test:public \
    --test_tag_filters="-private"


build:private \
    --build_tag_filters="-public"

test:private \
    --test_tag_filters="-public"


build:host \
    --build_tag_filters="host"

test:host \
    --test_tag_filters="host"


# --release_dpc=true makes a missing icpx a build error instead of skipping every test.
build:dpc \
    --build_tag_filters="dpc" \
    --release_dpc=true

test:dpc \
    --test_tag_filters="dpc"


build:host-public \
    --build_tag_filters="host,-private"

test:host-public \
    --test_tag_filters="host,-private"


build:host-private \
    --build_tag_filters="host,-public"

test:host-private \
    --test_tag_filters="host,-public"


build:dpc-public \
    --build_tag_filters="dpc,-private" \
    --release_dpc=true

test:dpc-public \
    --test_tag_filters="dpc,-private"


build:dpc-private \
    --build_tag_filters="dpc,-public" \
    --release_dpc=true

test:dpc-private \
    --test_tag_filters="dpc,-public"


# //:release builds every ISA unless --cpu is set and adds the DPC++ libraries when icpx is found.
build:release-dpc \
    --release_dpc=true

# Host ISA only, for local iteration. The platform suffix gives it its own
# output tree, so switching to and from the default build rebuilds nothing.
build:dev \
    --cpu=auto \
    --platform_suffix=dev


# Windows CRT selection (Make MSVC_RUNTIME_VERSION), independent of --config=dbg.

# Configuration: 'mdd'
# Link against the debug MSVC runtime (`-MDd`) and the `_debug` TBB variants.
# All libraries get a `d` suffix — `onedal_cored.lib`, `onedal_cored.4.dll` —
# so an MD and an MDd build can share one release tree. The toolchain, the
# library names and the dependency `select()`s all read this one setting.
#   bazel build //:release --config=mdd
#   bazel build //:release --config=mdd --config=dbg   # MDd + debug info
# Default (no --config=mdd) is the release runtime, `-MD`, unsuffixed names.
build:mdd \
    --msvc_runtime=debug

# To build BOTH runtimes into a single release tree in one command, use the
# //:release_all target instead of a --config (it applies both configurations
# internally via Bazel transitions):
#   bazel build //:release_all
# On non-Windows platforms //:release_all is equivalent to //:release.


# Make: REQDBG=yes.
build:dbg \
    --compilation_mode=dbg \
    --enable_assert=True

# Make: REQDBG=symbols. Keeps the opt build's optimization level.
build:dbg-symbols \
    --copt=-g


# Make: REQSAN=address. Combine with --config=dbg.
build:asan \
    --copt=-fsanitize=address \
    --copt=-fno-omit-frame-pointer \
    --linkopt=-fsanitize=address \
    --config=dbg-symbols

# Make: REQSAN=static.
build:asan-static \
    --copt=-fsanitize=address \
    --copt=-fno-omit-frame-pointer \
    --linkopt=-fsanitize=address \
    --linkopt=-static-libasan \
    --config=dbg-symbols


# Make: REQSAN=leak. Linux non-DPC++ targets only.
build:lsan \
    --copt=-fsanitize=leak \
    --copt=-fno-omit-frame-pointer \
    --linkopt=-fsanitize=leak \
    --config=dbg-symbols


# Make: REQSAN=thread.
build:tsan \
    --copt=-fsanitize=thread \
    --copt=-fno-omit-frame-pointer \
    --linkopt=-fsanitize=thread \
    --config=dbg-symbols


# Make: REQSAN=undefined.
build:ubsan \
    --copt=-fsanitize=undefined \
    --copt=-fno-omit-frame-pointer \
    --linkopt=-fsanitize=undefined \
    --config=dbg-symbols


# Needs clang and lld; GCC has no MemorySanitizer.
build:msan \
    --copt=-fsanitize=memory \
    --copt=-fsanitize-memory-track-origins \
    --copt=-fno-omit-frame-pointer \
    --linkopt=-fsanitize=memory \
    --linkopt=-fuse-ld=lld \
    --config=dbg-symbols

# Needs clang; GCC and icpx have no TypeSanitizer.
build:type \
    --copt=-fsanitize=type \
    --copt=-fsanitize-recover=all \
    --copt=-fno-omit-frame-pointer \
    --linkopt=-fsanitize=type \
    --linkopt=-fuse-ld=lld \
    --config=dbg-symbols

# On Windows, ONEDAL_WIN_COMPILER=cl (env or --repo_env) selects the rules_cc MSVC toolchain instead of icx.

# Machine-specific settings such as --jobs, and extra --copt/--linkopt (Make COPT); git-ignored.
try-import %workspace%/user.bazelrc
