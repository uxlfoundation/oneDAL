{
  "extends": ["config:recommended", ":preserveSemverRanges"],
  "pip_requirements": {
    "managerFilePatterns": ["/(^|/)docs/requirements.txt$/"]
  },
  "packageRules": [
    {
      "groupName": "Doc packages",
      "matchUpdateTypes": ["patch", "minor"],
      "schedule": ["before 2am on the first day of the month"],
      "matchFileNames": ["docs/requirements.txt"]
    },
    {
      "groupName": "Dockerfile",
      "schedule": ["before 2am on the first day of the month"],
      "matchFileNames": ["**/*.Dockerfile"]
    },
    {
      "matchPackageNames": [
        "intel-oneapi-compiler-dpcpp-cpp",
        "intel-oneapi-mkl-devel",
        "intel-oneapi-tbb-devel"
      ],
      "matchUpdateTypes": ["major", "minor"],
      "groupName": "intel-oneapi-apt"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.ci\\/env\\/editorconfig-checker\\.sh$/"],
      "matchStrings": [
        "VERSION[ \\t]*=[ \\t]*['\"]?(?<currentValue>v\\d+\\.\\d+\\.\\d+)['\"]?"
      ],
      "depNameTemplate": "editorconfig-checker/editorconfig-checker",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.ci\\/env\\/tbb.+$/",
        "/^(\\.github\\/workflows|\\.ci\\/pipeline)\\/ci.+$/",
        "/^dev\\/download_tbb.sh/",
        "/^\\.github\\/workflows\\/ci-win\\.yml$/"
      ],
      "matchStrings": [
        "TBB_DEFAULT_VERSION[ \\t]*=[ \\t]*['\"]?(?<currentValue>v?\\d+\\.\\d+\\.\\d+)['\"]?",
        "set[ \\t]+TBBVERSION[ \\t]*=[ \\t]*['\"]?(?<currentValue>v?\\d+\\.\\d+\\.\\d+)['\"]?",
        "TBB_VERSION[ \\t]*[:=][ \\t]*['\"]?(?<currentValue>v?\\d+\\.\\d+\\.\\d+)['\"]?"
      ],
      "depNameTemplate": "uxlfoundation/oneTBB",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.ci\\/env\\/openblas\\..+$/",
        "/^(\\.github\\/workflows|\\.ci\\/pipeline)\\/ci.+$/"
      ],
      "matchStrings": [
        "BLAS_DEFAULT_VERSION[ \\t]*=[ \\t]*['\"]?(?<currentValue>v?\\d+\\.\\d+\\.\\d+)['\"]?",
        "set[ \\t]+BLASVERSION[ \\t]*=[ \\t]*['\"]?(?<currentValue>v?\\d+\\.\\d+\\.\\d+)['\"]?",
        "OPENBLAS_VERSION[ \\t]*[:=][ \\t]*['\"]?(?<currentValue>v?\\d+\\.\\d+\\.\\d+)['\"]?"
      ],
      "depNameTemplate": "OpenMathLib/OpenBLAS",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/ci-win\\.yml$/"],
      "matchStrings": ["\\bLLVM_VERSION:[ \\t]*(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "llvm/llvm-project",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/ci-win\\.yml$/"],
      "matchStrings": ["\\bCMAKE_VERSION:[ \\t]*(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "Kitware/CMake",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/ci-win\\.yml$/"],
      "matchStrings": ["\\bNINJA_VERSION:[ \\t]*(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "ninja-build/ninja",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.ci\\/env\\/bazelisk\\.(sh|ps1)$/",
        "/^dev\\/docker\\/onedal\\-dev\\.Dockerfile/",
        "/^dev\\/bazel\\/README\\.md/"
      ],
      "matchStrings": [
        "BAZELISK_VERSION[ \\t]*=[ \\t]*['\"]?(?<currentValue>v\\d+\\.\\d+\\.\\d+)['\"]?",
        "bazeliskVersion[ \\t]*=[ \\t]*['\"]?(?<currentValue>v\\d+\\.\\d+\\.\\d+)['\"]?",
        "github\\.com/bazelbuild/bazelisk/releases/download/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/bazelisk-[^\\s\"']+"
      ],
      "depNameTemplate": "bazelbuild/bazelisk",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.ci\\/env\\/apt\\.sh$/"],
      "matchStrings": [
        ".*\\b(?<depName>intel-oneapi-compiler-dpcpp-cpp)=(?<currentValue>\\d{4}\\.\\d+\\.\\d+-\\d+).*"
      ],
      "datasourceTemplate": "deb",
      "registryUrlTemplate": "https://apt.repos.intel.com/oneapi?suite=all&components=main&binaryArch=amd64"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.ci\\/env\\/apt\\.sh$/"],
      "matchStrings": [
        ".*\\b(?<depName>intel-oneapi-mkl-devel)=(?<currentValue>\\d{4}\\.\\d+\\.\\d+-\\d+).*"
      ],
      "datasourceTemplate": "deb",
      "registryUrlTemplate": "https://apt.repos.intel.com/oneapi?suite=all&components=main&binaryArch=amd64"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.ci\\/env\\/apt\\.sh$/"],
      "matchStrings": [
        ".*\\b(?<depName>intel-oneapi-tbb-devel)=(?<currentValue>\\d{4}\\.\\d+\\.\\d+-\\d+).*"
      ],
      "datasourceTemplate": "deb",
      "registryUrlTemplate": "https://apt.repos.intel.com/oneapi?suite=all&components=main&binaryArch=amd64"
    }
  ]
}
