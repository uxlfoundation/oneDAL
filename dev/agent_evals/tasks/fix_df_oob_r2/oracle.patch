+        {
+            *resR2 = nSamples < 2         ? std::numeric_limits<intermSummFPType>::quiet_NaN() :
+                     sumSquaredError == 0 ? intermSummFPType(1) :
+                     yVariance == 0       ? intermSummFPType(0) :
+                                            1 - (sumSquaredError / static_cast<intermSummFPType>(nSamples)) / yVariance;
+        }
         return Status();
     }
 
