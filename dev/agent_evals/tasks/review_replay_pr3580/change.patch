+#ifndef __SVM_MODEL_IMPL_H__
+#define __SVM_MODEL_IMPL_H__
+
+#include "algorithms/svm/svm_model.h"
+#include "src/algorithms/classifier/classifier_model_impl.h"
+#include "src/services/serialization_utils.h"
+
+namespace daal
+{
