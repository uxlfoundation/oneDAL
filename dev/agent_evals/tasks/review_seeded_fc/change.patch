 .../data_management/finiteness_checker.cpp    | 26 +++++++++++++++++
 .../backend/cpu/compute_kernel_dense.cpp      | 24 +++++++++++++++
 .../detail/scan_helpers.hpp                   | 29 +++++++++++++++++++
 4 files changed, 80 insertions(+), 1 deletion(-)
 create mode 100644 cpp/oneapi/dal/algo/finiteness_checker/detail/scan_helpers.hpp

