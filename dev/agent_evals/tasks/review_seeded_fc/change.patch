diff --git a/cpp/oneapi/dal/algo/finiteness_checker/detail/scan_helpers.hpp b/cpp/oneapi/dal/algo/finiteness_checker/detail/scan_helpers.hpp
new file mode 100644
index 0000000..a2a84f1
--- /dev/null
+++ b/cpp/oneapi/dal/algo/finiteness_checker/detail/scan_helpers.hpp
@@ -0,0 +1,29 @@
+#ifndef __SCAN_HELPERS_HPP__
+#define __SCAN_HELPERS_HPP__
+
+#include <cmath>
+#include <cstdint>
+#include <span>
+
+namespace oneapi::dal::finiteness_checker::detail {
+namespace v1 {
+
+/// Counts values that are infinite, or NaN when NaN values are not allowed.
+template <typename Float>
+inline std::int64_t count_non_finite(std::span<const Float> values, bool allow_nan) {
+    std::int64_t count = 0;
+    for (const Float value : values) {
+        if (std::isinf(value) || (!allow_nan && std::isnan(value))) {
+            ++count;
+        }
+    }
+    return count;
+}
+
+} // namespace v1
+
+using v1::count_non_finite;
+
+} // namespace oneapi::dal::finiteness_checker::detail
+
+#endif // __SCAN_HELPERS_HPP__
