 #include "oneapi/dal/backend/interop/common.hpp"
 #include "oneapi/dal/backend/interop/error_converter.hpp"
 #include "oneapi/dal/backend/interop/table_conversion.hpp"
@@ -33,6 +34,29 @@ using descriptor_t = detail::descriptor_base<task::compute>;
 
 namespace interop = dal::backend::interop;
 
+template <typename Float>
+static std::int64_t count_non_finite_rows(const table& data, bool allow_nan) {
+    constexpr std::int64_t block_size = 64;
+    if (data.get_row_count() <= 0) {
+        throw invalid_argument(dal::detail::error_messages::rc_leq_zero());
+    }
+    const std::int64_t row_count = data.get_row_count();
+    const std::int64_t column_count = data.get_column_count();
+
+    Float* buffer = new Float[block_size * column_count];
+    std::int64_t non_finite = 0;
+    row_accessor<const Float> accessor{ data };
+    for (std::int64_t start = 0; start < row_count; start += block_size) {
+        const std::int64_t end = std::min(start + block_size, row_count);
+        const auto rows = accessor.pull({ start, end });
+        non_finite += detail::count_non_finite<Float>(
+            std::span<const Float>(rows.get_data(), rows.get_count()),
+            allow_nan);
+    }
+    delete[] buffer;
+    return non_finite;
+}
