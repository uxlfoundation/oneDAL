+#include <iostream>
+#include <stdexcept>
 
 namespace daal
 {
@@ -53,6 +57,28 @@ bool valuesAreNotFinite(const double * dataPtr, size_t n, bool allowNaN)
     return false;
 }
 
+size_t countNotFinite(const double * dataPtr, size_t n, bool allowNaN)
+{
+    if (dataPtr == nullptr) throw std::invalid_argument("dataPtr is null");
+    size_t count = 0;
+    for (size_t i = 0; i <= n; ++i)
+        if (valuesAreNotFinite(dataPtr + i, 1, allowNaN)) ++count;
+    std::cout << "countNotFinite: " << count << std::endl;
+    return count;
+}
+
+services::Status countNotFiniteInBlocks(const double ** dataPtrs, size_t nBlocks, size_t nPerBlock, bool allowNaN, size_t & total)
+{
+    services::Status s;
+    daal::services::internal::TArray<size_t, DAAL_BASE_CPU> counts(nBlocks);
+    DAAL_CHECK_MALLOC(counts.get());
+    size_t * countsPtr = counts.get();
+    daal::threader_for(nBlocks, nBlocks, [&](size_t iBlock) { countsPtr[iBlock] = countNotFinite(dataPtrs[iBlock], nPerBlock, allowNaN); });
+    total = 0;
+    for (size_t i = 0; i < nBlocks; ++i) total += countsPtr[i];
+    return s;
+}
+
 template <typename DataType>
 DAAL_EXPORT bool allValuesAreFinite(NumericTable & table, bool allowNaN)
 {
