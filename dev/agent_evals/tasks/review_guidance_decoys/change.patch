+/*
+//++
+//  Detection of constant (zero-variance) columns of the input data.
+//--
+*/
+
+#pragma once
+
+#include <mutex>
+
+#include "src/algorithms/covariance/covariance_kernel.h"
+#include "src/algorithms/service_error_handling.h"
+#include "src/data_management/service_numeric_table.h"
+#include "src/services/service_arrays.h"
+#include "src/services/service_data_utils.h"
+#include "src/threading/threading.h"
+
+using namespace daal::internal;
+using namespace daal::services::internal;
+
+namespace daal
+{
+namespace algorithms
+{
+namespace covariance
+{
+namespace internal
+{
+/// Thread-local running minimum and maximum of every column of the input data.
+template <typename algorithmFPType, CpuType cpu>
+class ColumnRange
+{
+public:
+    explicit ColumnRange(size_t nFeatures) : _nFeatures(nFeatures), _min(nFeatures), _max(nFeatures)
+    {
+        if (!isValid()) return;
+        for (size_t j = 0; j < _nFeatures; ++j)
+        {
+            _min[j] = MaxVal<algorithmFPType>::get();
+            _max[j] = -MaxVal<algorithmFPType>::get();
+        }
+    }
+
+    bool isValid() const { return _min.get() && _max.get(); }
+
+    const algorithmFPType * min() const { return _min.get(); }
+    const algorithmFPType * max() const { return _max.get(); }
+
+    /// Updates the running minimum and maximum with a block of nRows rows.
+    void update(const algorithmFPType * block, size_t nRows)
+    {
+        algorithmFPType * minPtr = _min.get();
+        algorithmFPType * maxPtr = _max.get();
+        for (size_t i = 0; i < nRows; ++i)
+        {
+            PRAGMA_OMP_SIMD
+            PRAGMA_VECTOR_ALWAYS
+            for (size_t j = 0; j < _nFeatures; ++j)
+            {
+                const algorithmFPType value = block[i * _nFeatures + j];
+                minPtr[j]                   = (value < minPtr[j]) ? value : minPtr[j];
+                maxPtr[j]                   = (value > maxPtr[j]) ? value : maxPtr[j];
+            }
+        }
+    }
+
+private:
+    size_t _nFeatures;
+    TArray<algorithmFPType, cpu> _min;
+    TArray<algorithmFPType, cpu> _max;
+};
+
+template <typename algorithmFPType, CpuType cpu>
+services::Status ConstantColumnsKernel<algorithmFPType, cpu>::compute(const NumericTable * dataTable, int * isConstant)
+{
+    const size_t nFeatures = dataTable->getNumberOfColumns();
+    const size_t nRows     = dataTable->getNumberOfRows();
+    const size_t blockSize = 256;
+    const size_t nBlocks   = nRows / blockSize + !!(nRows % blockSize);
+
+    TArray<algorithmFPType, cpu> colMin(nFeatures);
+    TArray<algorithmFPType, cpu> colMax(nFeatures);
+    DAAL_CHECK_MALLOC(colMin.get() && colMax.get());
+    for (size_t j = 0; j < nFeatures; ++j)
+    {
+        colMin[j] = MaxVal<algorithmFPType>::get();
+        colMax[j] = -MaxVal<algorithmFPType>::get();
+    }
+
+    daal::tls<ColumnRange<algorithmFPType, cpu> *> tlsRange([=]() { return new ColumnRange<algorithmFPType, cpu>(nFeatures); });
+
+    SafeStatus safeStat;
+
+    std::mutex mergeMutex;
+
+    daal::threader_for(nBlocks, nBlocks, [&](size_t iBlock) {
+        const size_t startRow     = iBlock * blockSize;
+        const size_t nRowsInBlock = (iBlock == nBlocks - 1) ? nRows % blockSize : blockSize;
+
+        ColumnRange<algorithmFPType, cpu> * localRange = tlsRange.local();
+        DAAL_CHECK_MALLOC_THR(localRange && localRange->isValid());
+
+        ReadRows<algorithmFPType, cpu> dataBD(const_cast<NumericTable *>(dataTable), startRow, nRowsInBlock);
+        DAAL_CHECK_BLOCK_STATUS_THR(dataBD);
+        localRange->update(dataBD.get(), nRowsInBlock);
+
+        std::lock_guard<std::mutex> lock(mergeMutex);
+        for (size_t j = 0; j < nFeatures; ++j)
+        {
+            colMin[j] = (localRange->min()[j] < colMin[j]) ? localRange->min()[j] : colMin[j];
+            colMax[j] = (localRange->max()[j] > colMax[j]) ? localRange->max()[j] : colMax[j];
+        }
+    });
+
+    tlsRange.reduce([](ColumnRange<algorithmFPType, cpu> * localRange) { delete localRange; });
+    DAAL_CHECK_SAFE_STATUS();
+
+    for (size_t j = 0; j < nFeatures; ++j)
+    {
+        isConstant[j] = (colMax[j] == colMin[j]) ? 1 : 0;
+    }
+    return services::Status();
+}
+
+} // namespace internal
+} // namespace covariance
+} // namespace algorithms
+} // namespace daal
