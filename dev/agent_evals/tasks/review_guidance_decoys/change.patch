                                      NumericTable * meanTable, const Parameter * parameter, const Hyperparameter * hyperparameter = nullptr);
 };
 
+/// Marks the columns of the input table that hold the same value in every row.
+/// Correlation is undefined for such columns because their variance is zero.
+///
+/// @tparam algorithmFPType     Data type used for the computations: double or float.
+/// @tparam cpu                 Variant of the CPU instruction set: SSE2, AVX2, AVX512, ARM SVE, etc.
+template <typename algorithmFPType, CpuType cpu>
+class ConstantColumnsKernel : public daal::algorithms::Kernel
+{
+public:
+    /// @param[in]  dataTable   Input data table of size nRows x nFeatures
+    /// @param[out] isConstant  Array of size nFeatures; isConstant[j] is set to 1 if column j is constant, to 0 otherwise
+    services::Status compute(const NumericTable * dataTable, int * isConstant);
+};
+
 } // namespace internal
 } // namespace covariance
 } // namespace algorithms
diff --git a/cpp/oneapi/dal/algo/covariance/backend/cpu/compute_kernel_dense.cpp b/cpp/oneapi/dal/algo/covariance/backend/cpu/compute_kernel_dense.cpp
index ddd6b34..ca3af96 100644
--- a/cpp/oneapi/dal/algo/covariance/backend/cpu/compute_kernel_dense.cpp
+++ b/cpp/oneapi/dal/algo/covariance/backend/cpu/compute_kernel_dense.cpp
@@ -43,6 +43,30 @@ template <typename Float, daal::internal::CpuType Cpu>
 using daal_covariance_kernel_t = daal_covariance::internal::
     CovarianceDenseBatchKernel<Float, daal_covariance::Method::defaultDense, Cpu>;
 
+template <typename Float, daal::internal::CpuType Cpu>
+using daal_constant_columns_kernel_t = daal_covariance::internal::ConstantColumnsKernel<Float, Cpu>;
+
+/// Throws if any column of the input holds the same value in every row
+template <typename Float>
+static void check_no_constant_columns(const context_cpu& ctx,
+                                      const daal::data_management::NumericTablePtr& daal_data,
+                                      std::int64_t component_count) {
+    auto arr_is_constant = array<int>::zeros(component_count);
+
+    interop::status_to_exception(
+        interop::call_daal_kernel<Float, daal_constant_columns_kernel_t>(
+            ctx,
+            daal_data.get(),
+            arr_is_constant.get_mutable_data()));
+
+    const int* is_constant = arr_is_constant.get_data();
+    for (std::int64_t i = 0; i < component_count; ++i) {
+        if (is_constant[i]) {
+            throw invalid_argument("Correlation matrix is undefined for a constant column");
+        }
+    }
+}
+
 template <typename Float, typename Task>
 static compute_result<Task> call_daal_spmd_kernel(const context_cpu& ctx,
                                                   const detail::descriptor_base<Task>& desc,
@@ -131,6 +155,11 @@ static compute_result<Task> call_daal_kernel(const context_cpu& ctx,
 
     const auto daal_data = interop::convert_to_daal_table<Float>(data);
 
+    // Correlation is undefined for zero-variance columns: reject such input up front
+    if (desc.get_result_options().test(result_options::cov_matrix)) {
+        check_no_constant_columns<Float>(ctx, daal_data, component_count);
+    }
+
     auto arr_means = array<Float>::empty(component_count);
     const auto daal_means = interop::convert_to_daal_homogen_table(arr_means, 1, component_count);
 
