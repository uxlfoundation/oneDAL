package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_library")

# A release tree built against the debug MSVC runtime names every library with
# a `d` suffix (`onedal_cored.lib`), mirroring the Makefile's `$d`. Tests that
# consume a prebuilt tree via --test_link_mode=release_* must pick the flavour
# matching the runtime they are compiled with.
# `@config//:msvc_runtime_debug` is generated by `config_flag` in
# dev/bazel/config/config.bzl.

cc_library(
    name = "headers",
    hdrs = glob([
        "include/**/*.h",
        "include/oneapi/**/*.hpp",
    ], allow_empty = True),
    includes = ["include"],
)

cc_library(
    name = "core_static",
    srcs = select({
        "@config//:msvc_runtime_debug": ["lib/%{arch_dir}/onedal_cored.lib"],
        "//conditions:default": ["lib/%{arch_dir}/onedal_core.lib"],
    }),
    deps = [
        ":headers",
        "@tbb//:tbb_binary",
        "@mkl//:mkl_static",
    ],
)

cc_library(
    name = "thread_static",
    srcs = select({
        "@config//:msvc_runtime_debug": ["lib/%{arch_dir}/onedal_threadd.lib"],
        "//conditions:default": ["lib/%{arch_dir}/onedal_thread.lib"],
    }),
    deps = [
        ":headers",
        "@tbb//:tbb_binary",
        "@tbb//:tbbmalloc_binary",
    ],
)

cc_library(
    name = "onedal_static",
    srcs = select({
        "@config//:msvc_runtime_debug": ["lib/%{arch_dir}/onedald.lib"],
        "//conditions:default": ["lib/%{arch_dir}/onedal.lib"],
    }),
    deps = [
        ":headers",
    ],
)

# Packaged oneDAL releases expose DPC libraries only in dynamic form, so no
# static-DPC consumer target is declared here either -- see `onedal.tpl.BUILD`.

cc_library(
    name = "core_dynamic",
    srcs = select({
        "@config//:msvc_runtime_debug": ["lib/%{arch_dir}/onedal_cored_dll.lib"],
        "//conditions:default": ["lib/%{arch_dir}/onedal_core_dll.lib"],
    }),
    data = select({
        "@config//:msvc_runtime_debug": [
            "redist/%{arch_dir}/onedal_cored.%{version_binary_major}.dll",
        ],
        "//conditions:default": [
            "redist/%{arch_dir}/onedal_core.%{version_binary_major}.dll",
        ],
    }),
    deps = [
        ":headers",
        "@tbb//:tbb_binary",
    ],
)

filegroup(
    name = "core_dynamic_runtime",
    srcs = select({
        "@config//:msvc_runtime_debug": [
            "redist/%{arch_dir}/onedal_cored.%{version_binary_major}.dll",
        ],
        "//conditions:default": [
            "redist/%{arch_dir}/onedal_core.%{version_binary_major}.dll",
        ],
    }),
)

cc_library(
    name = "thread_dynamic",
    srcs = [],
    data = select({
        "@config//:msvc_runtime_debug": [
            "redist/%{arch_dir}/onedal_threadd.%{version_binary_major}.dll",
        ],
        "//conditions:default": [
            "redist/%{arch_dir}/onedal_thread.%{version_binary_major}.dll",
        ],
    }),
    deps = [
        ":headers",
        "@tbb//:tbb_binary",
        "@tbb//:tbbmalloc_binary",
    ],
)

filegroup(
    name = "thread_dynamic_runtime",
    srcs = select({
        "@config//:msvc_runtime_debug": [
            "redist/%{arch_dir}/onedal_threadd.%{version_binary_major}.dll",
        ],
        "//conditions:default": [
            "redist/%{arch_dir}/onedal_thread.%{version_binary_major}.dll",
        ],
    }),
)

cc_library(
    name = "onedal_dynamic",
    srcs = select({
        "@config//:msvc_runtime_debug": ["lib/%{arch_dir}/onedald_dll.lib"],
        "//conditions:default": ["lib/%{arch_dir}/onedal_dll.lib"],
    }),
    data = select({
        "@config//:msvc_runtime_debug": [
            "redist/%{arch_dir}/onedald.%{version_binary_major}.dll",
        ],
        "//conditions:default": [
            "redist/%{arch_dir}/onedal.%{version_binary_major}.dll",
        ],
    }),
    deps = [
        ":headers",
        "@mkl//:mkl_static",
    ],
)

filegroup(
    name = "onedal_dynamic_runtime",
    srcs = glob([
        "lib/%{arch_dir}/onedal*.dll",
        "redist/%{arch_dir}/onedal*.dll",
    ], allow_empty = True),
)

# No `onedal_dynamic_dpc` here: `onedal_repo` declares no Windows DPC files, so
# the target could only be an empty library that links nothing.
