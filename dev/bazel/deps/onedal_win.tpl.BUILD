package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_library")

# A release tree built against the debug MSVC runtime names every library with
# a `d` suffix (`onedal_cored.lib`), mirroring the Makefile's `$d`. Tests that
# consume a prebuilt tree via --test_link_mode=release_* must pick the flavour
# matching the runtime they are compiled with.
# `@config//:msvc_runtime_debug` is generated by `config_flag` in
# dev/bazel/config/config.bzl.

cc_library(
    name = "headers",
    hdrs = glob([
        "include/**/*.h",
        "include/oneapi/**/*.hpp",
    ], allow_empty = True),
    includes = ["include"],
)

cc_library(
    name = "core_static",
    srcs = select({
        "@config//:msvc_runtime_debug": ["lib/intel64/onedal_cored.lib"],
        "//conditions:default": ["lib/intel64/onedal_core.lib"],
    }),
    deps = [
        ":headers",
        "@tbb//:tbb_binary",
        "@mkl//:mkl_static",
    ],
)

cc_library(
    name = "thread_static",
    srcs = select({
        "@config//:msvc_runtime_debug": ["lib/intel64/onedal_threadd.lib"],
        "//conditions:default": ["lib/intel64/onedal_thread.lib"],
    }),
    deps = [
        ":headers",
        "@tbb//:tbb_binary",
        "@tbb//:tbbmalloc_binary",
    ],
)

cc_library(
    name = "onedal_static",
    srcs = select({
        "@config//:msvc_runtime_debug": ["lib/intel64/onedald.lib"],
        "//conditions:default": ["lib/intel64/onedal.lib"],
    }),
    deps = [
        ":headers",
    ],
)

cc_library(
    name = "onedal_static_dpc",
    srcs = [],
    deps = [
        ":headers",
    ],
)

cc_library(
    name = "core_dynamic",
    srcs = select({
        "@config//:msvc_runtime_debug": ["lib/intel64/onedal_cored_dll.lib"],
        "//conditions:default": ["lib/intel64/onedal_core_dll.lib"],
    }),
    data = select({
        "@config//:msvc_runtime_debug": [
            "redist/intel64/onedal_cored.%{version_binary_major}.dll",
        ],
        "//conditions:default": [
            "redist/intel64/onedal_core.%{version_binary_major}.dll",
        ],
    }),
    deps = [
        ":headers",
        "@tbb//:tbb_binary",
    ],
)

filegroup(
    name = "core_dynamic_runtime",
    srcs = select({
        "@config//:msvc_runtime_debug": [
            "redist/intel64/onedal_cored.%{version_binary_major}.dll",
        ],
        "//conditions:default": [
            "redist/intel64/onedal_core.%{version_binary_major}.dll",
        ],
    }),
)

cc_library(
    name = "thread_dynamic",
    srcs = [],
    data = select({
        "@config//:msvc_runtime_debug": [
            "redist/intel64/onedal_threadd.%{version_binary_major}.dll",
        ],
        "//conditions:default": [
            "redist/intel64/onedal_thread.%{version_binary_major}.dll",
        ],
    }),
    deps = [
        ":headers",
        "@tbb//:tbb_binary",
        "@tbb//:tbbmalloc_binary",
    ],
)

filegroup(
    name = "thread_dynamic_runtime",
    srcs = select({
        "@config//:msvc_runtime_debug": [
            "redist/intel64/onedal_threadd.%{version_binary_major}.dll",
        ],
        "//conditions:default": [
            "redist/intel64/onedal_thread.%{version_binary_major}.dll",
        ],
    }),
)

cc_library(
    name = "onedal_dynamic",
    srcs = select({
        "@config//:msvc_runtime_debug": ["lib/intel64/onedald_dll.lib"],
        "//conditions:default": ["lib/intel64/onedal_dll.lib"],
    }),
    data = select({
        "@config//:msvc_runtime_debug": [
            "redist/intel64/onedald.%{version_binary_major}.dll",
        ],
        "//conditions:default": [
            "redist/intel64/onedal.%{version_binary_major}.dll",
        ],
    }),
    deps = [
        ":headers",
        "@mkl//:mkl_static",
    ],
)

filegroup(
    name = "onedal_dynamic_runtime",
    srcs = glob([
        "lib/intel64/onedal*.dll",
        "redist/intel64/onedal*.dll",
    ], allow_empty = True),
)

cc_library(
    name = "onedal_dynamic_dpc",
    srcs = [],
    deps = [
        ":headers",
    ],
)
