package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_library")

# The `_debug` TBB variants are linked when oneDAL is built against the debug
# MSVC runtime (`--config=mdd`), mirroring `dep_thr` in makefile:330. Mixing
# release TBB into an `-MDd` build would pull in two CRTs.
# `@config//:msvc_runtime_debug` is generated by `config_flag` in
# dev/bazel/config/config.bzl.

cc_library(
    name = "headers",
    hdrs = glob(["include/**/*.h", "include/**/*.hpp"], allow_empty = True),
    includes = ["include"],
)

cc_library(
    name = "tbb",
    srcs = select({
        "@config//:msvc_runtime_debug": ["lib/tbb12_debug.lib"],
        "//conditions:default": ["lib/tbb12.lib"],
    }),
    data = select({
        "@config//:msvc_runtime_debug": ["bin/tbb12_debug.dll"],
        "//conditions:default": ["bin/tbb12.dll"],
    }),
    deps = [":headers"],
)

filegroup(
    name = "tbb_runtime",
    srcs = select({
        "@config//:msvc_runtime_debug": [
            "bin/tbb12_debug.dll",
            "bin/tbbmalloc_debug.dll",
        ],
        "//conditions:default": [
            "bin/tbb12.dll",
            "bin/tbbmalloc.dll",
        ],
    }),
)

cc_library(
    name = "tbb_binary",
    deps = [":tbb"],
)

cc_library(
    name = "tbbmalloc",
    srcs = select({
        "@config//:msvc_runtime_debug": ["lib/tbbmalloc_debug.lib"],
        "//conditions:default": ["lib/tbbmalloc.lib"],
    }),
    data = select({
        "@config//:msvc_runtime_debug": ["bin/tbbmalloc_debug.dll"],
        "//conditions:default": ["bin/tbbmalloc.dll"],
    }),
    deps = [":headers"],
)

cc_library(
    name = "tbbmalloc_binary",
    deps = [":tbbmalloc"],
)
